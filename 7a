from itertools import combinations

def equal_average_partition(arr):
    n = len(arr)
    total_sum = sum(arr)
    arr.sort() 
    
    for len1 in range(1, n // 2 + 1):
        if (total_sum * len1) % n != 0:
            continue
        target_sum = (total_sum * len1) // n
        
        for part1 in combinations(arr, len1):
            if sum(part1) == target_sum:
                part2 = arr.copy()
                for x in part1:
                    part2.remove(x)
                return list(part1), part2
    return -1
