def min_cost_tl_to_br(grid):
    if not grid or not grid[0]: return 0
    R, C = len(grid), len(grid[0])
    dp = [[0] * C for _ in range(R)]
    
    for i in range(R):
        for j in range(C):
            if i == 0 and j == 0:
                dp[i][j] = grid[i][j]
            elif i == 0:
                dp[i][j] = dp[i][j-1] + grid[i][j]
            elif j == 0:
                dp[i][j] = dp[i-1][j] + grid[i][j]
            else:
                dp[i][j] = min(dp[i-1][j], dp[i][j-1]) + grid[i][j]
                
    print(dp[R-1][C-1])
