from itertools import combinations

def min_elements_exact_sum(arr, T):
    arr.sort() 
    n = len(arr)
    
    for length in range(1, n + 1):
        for subset in combinations(arr, length):
            if sum(subset) == T:
                return list(subset)
    return -1
