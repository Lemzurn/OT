import math
from itertools import permutations

def min_ncr_positive_r(arr):
    min_val, best_n, best_r = float('inf'), -1, -1
    for n, r in permutations(arr, 2):
        if 0 < r <= n:
            val = math.comb(n, r)
            if val < min_val:
                min_val, best_n, best_r = val, n, r
                
    if min_val == float('inf'):
        print(-1)
    else:
        print(f"n: {best_n}, r: {best_r}, Min nCr: {min_val}")
